# Environment Configuration for Pandita's Aether-DCTWIN
# Copy this file to .env and fill in your optional LLM API keys

# Primary LLM Provider for the Autonomous Tool-Calling Agent ("openrouter" or "openai")
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Optional alternative LLM keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Server Host & Port
HOST=0.0.0.0
PORT=8000
